# Apex20 — Development Tooling Image
# Provides Go, Node.js, golangci-lint, buf and protobuf plugins
# Runs as the host user to avoid bind mount permission issues
FROM golang:1.26-bookworm AS go-base

FROM node:24-bookworm

ARG UID=1000
ARG GID=1000

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy Go from official image
COPY --from=go-base /usr/local/go/ /usr/local/go/
ENV PATH="/usr/local/go/bin:${PATH}"

# Create group and user matching the host UID/GID.
# If the GID/UID already exists (e.g. node:1000 in the base image), rename it to dev.
RUN existing_group=$(getent group ${GID} | cut -d: -f1); \
    if [ -z "$existing_group" ]; then \
      groupadd --gid ${GID} dev; \
    elif [ "$existing_group" != "dev" ]; then \
      groupmod -n dev "$existing_group"; \
    fi && \
    existing_user=$(getent passwd ${UID} | cut -d: -f1); \
    if [ -z "$existing_user" ]; then \
      useradd --uid ${UID} --gid ${GID} --create-home --shell /bin/bash dev; \
    elif [ "$existing_user" != "dev" ]; then \
      usermod -l dev -d /home/dev -m "$existing_user" && usermod -s /bin/bash dev; \
    fi

# Set GOPATH under the dev home so the user can write to it
ENV GOPATH="/home/dev/go"
ENV PATH="/home/dev/go/bin:${PATH}"
RUN mkdir -p /home/dev/go && chown -R ${UID}:${GID} /home/dev/go

USER dev

# Install Go tools as dev user (written to GOPATH = /home/dev/go)
RUN go install github.com/golangci/golangci-lint/cmd/golangci-lint@latest && \
    go install google.golang.org/protobuf/cmd/protoc-gen-go@latest && \
    go install connectrpc.com/connect/cmd/protoc-gen-connect-go@latest

# Install Buf CLI
RUN curl -sSL \
    "https://github.com/bufbuild/buf/releases/download/v1.30.0/buf-$(uname -s)-$(uname -m)" \
    -o /home/dev/go/bin/buf && \
    chmod +x /home/dev/go/bin/buf

WORKDIR /workspace

CMD ["sleep", "infinity"]
